# Copy to web/.env.local (which is gitignored) and fill in.
#
# Must be a role that inherits ii_app: SELECT on market data, full CRUD on the
# user schema, and no ability to mutate history. Invariant 9 and invariant 10
# are enforced by the database, not by this application being careful.
#
# Generate a password rather than reusing the documented local default:
#   psql -c "ALTER ROLE ii_web LOGIN PASSWORD '$(openssl rand -base64 24)'"
DATABASE_URL=postgresql://ii_web:REPLACE_ME@localhost:5432/ii_dev
